# Copy values into the service manager's private environment file. This file
# is documentation only; Heligent does not automatically load .env files.
DATABASE_URL=postgresql://heligent:change-me@127.0.0.1/heligent_adsb
OPENAI_API_KEY=replace-with-a-server-side-key
OPENAI_MODEL=gpt-5.4-mini

# Optional Raspberry Pi raw-archive feeder. Configure both values to enable the
# Pi source in the ingestion UI. Use the private Tailscale Serve HTTPS URL.
ADSB_ARCHIVE_API_URL=https://adsb-archive.example-tailnet.ts.net
ADSB_ARCHIVE_API_TOKEN=replace-with-the-same-long-random-token-as-the-pi

# Service-to-service API used by the CRM. Use a separate random secret.
HELIGENT_API_TOKEN=replace-with-a-long-random-service-token

# Authenticated maintenance UI behind ngrok OAuth. The proxy secret must match
# the value added by the ngrok Traffic Policy. Bootstrap only inserts users that
# do not yet exist.
HELIGENT_AUTH_MODE=NGROK
HELIGENT_AUTH_PROXY_SECRET=replace-with-at-least-32-random-characters
HELIGENT_BOOTSTRAP_ADMIN_EMAILS=you@example.com

# Public mobile-demo process only.
HELIGENT_PUBLIC_DEMO=true
HELIGENT_TRUSTED_PROXY_COUNT=1
HELIGENT_QUERY_PER_MINUTE=10
HELIGENT_QUERY_PER_DAY=250
HELIGENT_QUERY_MAX_CONCURRENT=2
