[Unit]
Description=Verify one retained Heligent ADS-B archive day for %i
RequiresMountsFor=/mnt/adsb-archive
ConditionPathIsMountPoint=/mnt/adsb-archive

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/heligent
EnvironmentFile=/etc/heligent/adsb-archive
ExecStart=/opt/heligent/.venv/bin/adsb-archive verify-next
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
