# SSD mount point. Keep the SQLite queue and release data on the SSD together.
ADSB_ARCHIVE_ROOT=/mnt/adsb-archive

# Optional, but recommended for a sizeable backfill to avoid GitHub API limits.
# Create a fine-grained, read-only token; do not commit the real value.
GITHUB_TOKEN=

# Required by the read-only feeder API. Generate with: openssl rand -hex 32
ADSB_ARCHIVE_API_TOKEN=replace-with-a-long-random-token
