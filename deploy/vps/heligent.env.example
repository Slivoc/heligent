# PostgreSQL uses local peer authentication: the Linux and PostgreSQL roles are
# both named heligent. No database password is stored in this file.
DATABASE_URL=postgresql:///heligent_adsb

# Public maintenance UI. The same 64-character hex secret must be placed in
# ngrok-traffic-policy.yml. The bootstrap address becomes the first local ADMIN.
HELIGENT_AUTH_MODE=NGROK
HELIGENT_AUTH_PROXY_SECRET=replace-with-64-random-hex-characters
HELIGENT_BOOTSTRAP_ADMIN_EMAILS=
HELIGENT_TRUSTED_PROXY_COUNT=1

# Private Sproutt-to-Heligent API. Use a different random value.
HELIGENT_API_TOKEN=replace-with-a-separate-64-character-random-token

# Optional natural-language Explorer. Leave the key empty to disable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional CARTO basemap for the watched-aircraft flight map. Browser-visible
# tile key only (not an OpenAI/Heligent secret). Register the app domain with CARTO.
HELIGENT_CARTO_BASEMAP_KEY=

# Raspberry Pi raw archive, reached only over Tailscale.
ADSB_ARCHIVE_API_URL=
ADSB_ARCHIVE_API_TOKEN=
